#!/bin/bash
set -e

echo "🔍 Running pre-commit integrity and formatting checks..."

# 1. Check for accidental secret commits
STAGED_FILES=$(git diff --cached --name-only)

if echo "$STAGED_FILES" | grep -q "SigmaStream/Core/Secrets.swift"; then
    if git diff --cached SigmaStream/Core/Secrets.swift | grep -v '^[+-]import' | grep -q -E 'tmdbApiKey = "[a-zA-Z0-9]{15,}"'; then
        echo "ERROR: You are attempting to commit real credentials in SigmaStream/Core/Secrets.swift!"
        echo "Please unstage this file before committing."
        exit 1
    fi
fi

if echo "$STAGED_FILES" | grep -q "backend/\.env$"; then
    echo "ERROR: You are attempting to commit backend/.env!"
    echo "Environment files containing private keys should never be committed."
    exit 1
fi

# 2. Check if any backend files were modified
BACKEND_STAGED=$(echo "$STAGED_FILES" | grep -E '^backend/' || true)

if [ -n "$BACKEND_STAGED" ]; then
    echo "Backend files staged. Verifying TypeScript type safety and formatting..."
    
    cd backend
    
    # Check Prettier formatting
    if ! npx prettier --check src; then
        echo "Code formatting issues detected. Running Prettier..."
        npx prettier --write src
        git add src/
        echo "Files automatically formatted and re-staged."
    fi
    
    # Run TypeScript Typecheck
    if ! npx tsc --noEmit; then
        echo "ERROR: TypeScript type checking failed! Fix compilation errors before committing."
        exit 1
    fi
    
    cd ..
fi

echo "Pre-commit checks passed successfully!"
exit 0
