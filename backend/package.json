{
    "name": "@cinepro/core",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "npm run build && node dist/server.js",
        "format": "prettier --write src",
        "clean": "npx rimraf dist",
        "dev:awake": "caffeinate -is tsx watch src/server.ts",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@omss/framework": "^1.1.19",
        "cheerio": "^1.2.0",
        "crypto-js": "^4.2.0",
        "dotenv": "^16.4.5",
        "ioredis": "^6.0.0",
        "kokoro-js": "^1.2.1",
        "semver": "^7.8.5",
        "toad-cache": "^3.7.0",
        "wavefile": "^11.0.0"
    },
    "devDependencies": {
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^26.4.0",
        "patch-package": "^8.0.1",
        "prettier": "^3.3.3",
        "tsx": "^4.23.13",
        "typescript": "^5.6.2"
    }
}
