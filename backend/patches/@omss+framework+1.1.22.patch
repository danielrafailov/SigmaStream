+/** Cap per-provider fetch duration (PROVIDER_FETCH_TIMEOUT_MS). */
+function omssProviderTimeoutMs() {
+    const raw = Number.parseInt(process.env.PROVIDER_FETCH_TIMEOUT_MS ?? '25000', 10);
+    const ms = Number.isFinite(raw) ? raw : 25000;
+    return Math.min(Math.max(ms, 3000), 600000);
+}
+function withFetchTimeout(promise, ms, label) {
+    if (!Number.isFinite(ms) || ms <= 0)
+        return promise;
+    const timeoutError = new Error(`${label}: timed out after ${ms}ms`);
+    return new Promise((resolve, reject) => {
+        const t = setTimeout(() => reject(timeoutError), ms);
+        promise
+            .then((v) => {
+                clearTimeout(t);
+                resolve(v);
+            })
+            .catch((e) => {
+                clearTimeout(t);
+                reject(e);
+            });
+    });
+}
